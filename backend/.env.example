# PostgreSQL connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/calendly_clone?schema=public"

# Server port (defaults to 5000 if not set)
PORT=5000

# Secret used to sign access and refresh tokens (replace with a long random value)
JWT_SECRET=replace-with-a-long-random-secret

# PanelFlow AI / RAG
# Secondary LLM provider
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash

# Primary LLM provider (used for all Groq calls)
GROQ_API_KEY=
AI_GROQ_MODEL=qwen/qwen3.8-27b

# Gemini embeddings (1536 dimensions keeps compatibility with the existing pgvector schema)
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536

# Retrieval / context controls
AI_RETRIEVAL_TOP_K=8
AI_MIN_SIMILARITY=0.25
AI_CHUNK_SIZE=900
AI_CHUNK_OVERLAP=120
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_CHARS=8000
AI_GROQ_FALLBACK_COOLDOWN_MS=60000
