# PostgreSQL connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/calendly_clone?schema=public"

# Server port (defaults to 5000 if not set)
PORT=5000

# Frontend origin allowed to send authenticated cross-origin requests
FRONTEND_URL=http://localhost:3000

# Secret used to sign access and refresh tokens (replace with a long random value)
JWT_SECRET=replace-with-a-long-random-secret

# PanelFlow AI / RAG
# Secondary LLM provider
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash

# Primary LLM provider (used for all Groq calls)
GROQ_API_KEY=
AI_GROQ_MODEL=qwen/qwen3.8-27b

# Gemini embeddings (1536 dimensions keeps compatibility with the existing pgvector schema)
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536

# Retrieval / context controls
AI_RETRIEVAL_TOP_K=8
AI_MIN_SIMILARITY=0.25
AI_CHUNK_SIZE=900
AI_CHUNK_OVERLAP=120
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_CHARS=8000
AI_GROQ_FALLBACK_COOLDOWN_MS=60000

# Redis (Shared rate limiting, slot caching, auth session acceleration)
REDIS_URL=

# Kafka (Upstash Kafka or Confluent Cloud)
KAFKA_BROKERS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_USE_SSL=true
# Aiven/self-signed CA certificate in PEM format; preserve newlines as \n.
KAFKA_SSL_CA=
# Keep certificate verification enabled. Only disable temporarily for local troubleshooting.
KAFKA_SSL_REJECT_UNAUTHORIZED=true
KAFKA_RETRY_COUNT=8
KAFKA_CLIENT_ID=panelflow-backend
KAFKA_GROUP_ID=panelflow-core-consumers

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Observability
SENTRY_DSN=
