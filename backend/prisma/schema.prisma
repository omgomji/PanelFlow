generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INTERVIEWER
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum BookingStatus {
  SCHEDULED
  CANCELLED
  NO_SHOW
}

model User {
  id                   Int                   @id @default(autoincrement())
  username             String                @unique
  name                 String
  email                String                @unique
  timezone             String                @default("Asia/Kolkata")
  passwordHash         String                @default("")
  role                 Role                  @default(INTERVIEWER)
  availabilitySchedule AvailabilitySchedule?
  bookings             Booking[]
  contacts             Contact[]
  eventTypes           EventType[]
  createdPositions     Position[]
  panelMemberships     PanelInterviewer[]
  hostedBookings       BookingHost[]
  feedback             Feedback[]
  refreshSessions      RefreshSession[]
  tokenVersion         Int                   @default(0)
  aiAccessVersion      Int                   @default(0)
}

model EventType {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  slug        String
  duration    Int
  description String?
  isActive    Boolean   @default(true)
  bookings    Booking[]
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, slug])
}

model AvailabilitySchedule {
  id                        Int                        @id @default(autoincrement())
  userId                    Int                        @unique
  timezone                  String
  beforeEventBufferMinutes  Int                        @default(0)
  afterEventBufferMinutes   Int                        @default(0)
  startTimeIncrementMinutes Int                        @default(30)
  minimumNoticeMinutes      Int                        @default(0)
  maximumDaysInFuture       Int                        @default(60)
  allowBackToBack           Boolean                    @default(true)
  days                      AvailabilityDay[]
  dateOverrides             AvailabilityDateOverride[]
  user                      User                       @relation(fields: [userId], references: [id])
}

model AvailabilityDay {
  id         Int                    @id @default(autoincrement())
  scheduleId Int
  dayOfWeek  Int
  intervals  AvailabilityInterval[]
  schedule   AvailabilitySchedule   @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, dayOfWeek])
}

model AvailabilityInterval {
  id        Int              @id @default(autoincrement())
  dayId     Int
  startTime String
  endTime   String
  order     Int
  day       AvailabilityDay  @relation(fields: [dayId], references: [id])

  @@unique([dayId, order])
  @@index([dayId, startTime, endTime])
}

model AvailabilityDateOverride {
  id                        Int                               @id @default(autoincrement())
  scheduleId                Int
  date                      DateTime                          @db.Date
  intervals                 AvailabilityDateOverrideInterval[]
  schedule                  AvailabilitySchedule              @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, date])
  @@index([scheduleId, date])
}

model AvailabilityDateOverrideInterval {
  id         Int                      @id @default(autoincrement())
  overrideId Int
  startTime  String
  endTime    String
  order      Int
  override   AvailabilityDateOverride @relation(fields: [overrideId], references: [id])

  @@unique([overrideId, order])
  @@index([overrideId, startTime, endTime])
}

model Position {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  status      PositionStatus @default(OPEN)
  createdById Int
  createdBy   User           @relation(fields: [createdById], references: [id])
  panels      Panel[]
  createdAt   DateTime       @default(now())
}

model Panel {
  id           Int                @id @default(autoincrement())
  positionId   Int
  title        String
  slug         String             @unique
  duration     Int
  isActive     Boolean            @default(true)
  position     Position           @relation(fields: [positionId], references: [id])
  interviewers PanelInterviewer[]
  bookings     Booking[]
}

model PanelInterviewer {
  id      Int   @id @default(autoincrement())
  panelId Int
  userId  Int
  panel   Panel @relation(fields: [panelId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@unique([panelId, userId])
}

model Booking {
  id                 Int           @id @default(autoincrement())
  uid                String        @unique @default(uuid())
  eventTypeId        Int?
  userId             Int?
  panelId            Int?
  inviteeName        String
  inviteeEmail       String
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  inviteeNotes       String?
  status             BookingStatus @default(SCHEDULED)
  cancellationReason String?
  createdAt          DateTime      @default(now())
  eventType          EventType?    @relation(fields: [eventTypeId], references: [id])
  user               User?         @relation(fields: [userId], references: [id])
  panel              Panel?        @relation(fields: [panelId], references: [id])
  hosts              BookingHost[]
  feedback           Feedback[]

  @@index([userId, status, startTime, endTime])
  @@index([userId, startTime])
  @@index([startTime])
  @@index([panelId])
}

model BookingHost {
  id        Int           @id @default(autoincrement())
  bookingId Int
  userId    Int
  startTime DateTime
  endTime   DateTime
  status    BookingStatus
  booking   Booking       @relation(fields: [bookingId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([bookingId])
  @@index([userId, status, startTime, endTime])
}

model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  email     String
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, email])
  @@index([userId, createdAt])
}

model RefreshSession {
  id          Int       @id @default(autoincrement())
  userId      Int
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedFrom Int?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

enum Recommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES
}

model Feedback {
  id             Int            @id @default(autoincrement())
  bookingId      Int
  interviewerId  Int
  recommendation Recommendation
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  booking        Booking        @relation(fields: [bookingId], references: [id])
  interviewer    User           @relation(fields: [interviewerId], references: [id])

  @@unique([bookingId, interviewerId])
  @@index([bookingId])
}

model RagSource {
  id           String   @id @default(uuid()) @db.Uuid
  sourceType   String
  sourceId     String
  contentHash  String
  indexVersion Int      @default(1)
  chunkCount   Int      @default(0)
  indexedAt    DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([updatedAt])
  @@map("rag_sources")
}

model RagChunk {
  id        String                @id @db.Uuid
  content   String
  metadata  Json
  embedding Unsupported("vector")

  @@map("rag_chunks")
}
